# Red Hat base images (spec 01 §3.1). The only external images C-Flex uses.
# Tags here are the stream; install/build-bundle pulls each, resolves its digest, builds
# FROM <repo>@<digest> and records both in MANIFEST.json — so a release is pinned to an
# exact image even though this file names a stream. registry.redhat.io needs a
# `podman login` with a Red Hat account on the build host; registry.access.redhat.com does not.
UBI8_NODEJS_20=registry.access.redhat.com/ubi8/nodejs-20:1
UBI8_NGINX_122=registry.access.redhat.com/ubi8/nginx-122:1
RHEL8_REDIS_6=registry.redhat.io/rhel8/redis-6:1
RHEL8_POSTGRESQL_16=registry.redhat.io/rhel8/postgresql-16:1
