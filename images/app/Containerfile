# cflex/app — Local Console API (apps/console) + the UI: the FMS 1.x screen, internal build (frontend/, D-16).
# Spec 01 §2.2, §3.1. Build context = repository root:
#   podman build --format docker -f images/app/Containerfile \
#     --build-arg BASE_IMAGE=registry.access.redhat.com/ubi8/nodejs-20@sha256:… -t cflex/app:<ver> .
ARG BASE_IMAGE=registry.access.redhat.com/ubi8/nodejs-20:1

# ── ui: the FMS 1.x screen, internal build (D-16 — apps/twin moved to the portal) ──
# No Google Fonts (IBM Plex bundled), no map library or tiles; alarm map, tickets, reports, routing
# and device control are compiled out (VITE_CONSOLE_PROFILE=internal).
FROM ${BASE_IMAGE} AS ui
USER 1001
WORKDIR /opt/app-root/src
COPY --chown=1001:0 frontend/package.json frontend/package-lock.json frontend/
RUN cd frontend && npm ci --no-audit --no-fund
COPY --chown=1001:0 frontend frontend
RUN cd frontend && npm run build:console

# ── deps: console runtime — pg (PostgreSQL 16 on db01, pure JS) and better-sqlite3 (read once by
# bin/cflex-migrate-sqlite.js, the pre-WO-INT-008 store; Node 20 has no node:sqlite) ──
# better-sqlite3 is compiled from source against UBI8 glibc, as in images/collector (no prebuild runs
# on RHEL 8's glibc 2.28). Node 20 ABI (NODE_MODULE_VERSION 115); build-bundle checks it and pg.
FROM ${BASE_IMAGE} AS deps
# C++20 for better-sqlite3 11.x — gcc-toolset-13 in this stage only (see images/collector).
USER 0
RUN dnf -y install gcc-toolset-13-gcc-c++ && dnf clean all
USER 1001
WORKDIR /opt/app-root/src
COPY --chown=1001:0 apps/console/package.json apps/console/
RUN . /opt/rh/gcc-toolset-13/enable && cd apps/console \
 && npm_config_build_from_source=true npm install --omit=dev --no-audit --no-fund \
 && node -e "require('better-sqlite3')(':memory:').close(); require('pg')" \
 && npm cache clean --force

# ── runtime ──
FROM ${BASE_IMAGE}
ARG CFLEX_VERSION=0.0.0-dev
ARG CFLEX_COMMIT=unknown
LABEL name="cflex/app" \
      vendor="RingOn" \
      version="${CFLEX_VERSION}" \
      org.opencontainers.image.revision="${CFLEX_COMMIT}" \
      summary="C-Flex Local Console API — HAEA on-prem" \
      io.k8s.description="Local accounts, alarms/ACK, devices/trends, settings, collector ingest"

# Repository layout kept: the console requires ../../../probe-agent/src/* (contract schema,
# alarm notifier, transport) and ../../packages/notify by relative path.
WORKDIR /opt/cflex
COPY --from=deps --chown=0:0 /opt/app-root/src/apps/console/node_modules apps/console/node_modules
COPY --chown=0:0 apps/console/package.json apps/console/
COPY --chown=0:0 apps/console/src apps/console/src
COPY --chown=0:0 apps/console/migrations apps/console/migrations
COPY --chown=0:0 apps/console/bin apps/console/bin
COPY --chown=0:0 apps/console/public apps/console/public
COPY --chown=0:0 probe-agent/package.json probe-agent/
COPY --chown=0:0 probe-agent/src probe-agent/src
COPY --chown=0:0 packages/notify/package.json packages/notify/
COPY --chown=0:0 packages/notify/src packages/notify/src
COPY --chown=0:0 docs/spec/schemas docs/spec/schemas
COPY --from=ui --chown=0:0 /opt/app-root/src/frontend/dist-console frontend/dist-console
COPY --chown=0:0 images/app/healthcheck.js healthcheck.js

ENV NODE_ENV=production \
    CONSOLE_BIND=127.0.0.1 \
    CONSOLE_PORT=8080 \
    CONSOLE_UI_DIR=/opt/cflex/frontend/dist-console

VOLUME ["/opt/app/cflex/data"]
EXPOSE 8080/tcp
USER 1001
WORKDIR /opt/cflex/apps/console
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "/opt/cflex/healthcheck.js"]
CMD ["node", "/opt/cflex/apps/console/src/server.js"]
