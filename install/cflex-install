#!/bin/bash
# cflex-install — C-Flex on-prem installer (docs/spec/01 §3.3). See docs/install/CONTAINER_PROFILE.md.
# Runs on the Python every RHEL host already has: platform-python on RHEL 8, python3 on RHEL 9.
# -I: ignore PYTHON* environment and user site-packages (we run as root).
# -B: write no .pyc — the bundle must stay byte-identical to its SHA256SUMS.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for py in /usr/libexec/platform-python python3; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" -I -B "$here/lib/run.py" cflex_install "$@"
  fi
done
echo "cflex-install: no python3 found (RHEL 8: /usr/libexec/platform-python)" >&2
exit 2
