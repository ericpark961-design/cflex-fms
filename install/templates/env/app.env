# cflex-app (Local Console API) environment — rendered by cflex-install @@INSTALLER_VERSION@@ (0600, owner cflex).
# Same on app01 and app02 except CONSOLE_NODE_ID and REDIS_URL. Secrets are files, never values here.
NODE_ENV=production
TZ=@@TIMEZONE@@
CONSOLE_NODE_ID=@@NODE_ID@@
CONSOLE_BIND=@@CONSOLE_BIND@@
CONSOLE_PORT=8080
# PostgreSQL 16 on db01 (WO-INT-008) — the same database for app01 and app02. The password is the
# file (copied from db01 /opt/app/cflex/secrets/db/pg.pass), never a value here.
CFLEX_DB_HOST=@@DB_HOST@@
CFLEX_DB_PORT=@@DB_PORT@@
CFLEX_DB_NAME=cflex
CFLEX_DB_USER=cflex
CFLEX_DB_PASSWORD_FILE=@@SECRETS_DIR@@/pg.pass
# Retention (site.yaml `retention`) and month partitions made ahead (spec 01 §2.3).
CFLEX_RETENTION_RAW_YEARS=@@RET_RAW@@
CFLEX_RETENTION_AGGREGATE_YEARS=@@RET_AGG@@
CFLEX_RETENTION_EVENTS_YEARS=@@RET_EVENTS@@
CFLEX_PARTITION_AHEAD_MONTHS=3
# The pre-WO-INT-008 SQLite file, read once by bin/cflex-migrate-sqlite.js during the upgrade.
CONSOLE_DB=@@DATA_DIR@@/console.db
REDIS_URL=redis://@@REDIS_ADDR@@:6379/0
REDIS_PASSWORD_FILE=@@SECRETS_DIR@@/redis.pass
CONSOLE_SECRET_KEY_FILE=@@SECRETS_DIR@@/console.key
CFLEX_TENANT=@@TENANT@@
CFLEX_TENANT_NAME=@@TENANT@@
CONSOLE_TRUST_PROXY=1
# Portal (contract 00 v1.2, FW-4 app → cflex.fms.support 443), D-13: this node sends for every
# collector — whichever app node holds the sender lock drains the 7-day outbox (db01 portal_outbox).
# The device key (CN <tenant>.@@NODE_ID@@) never leaves this node (contract §6); only its path is here.
CFLEX_PORTAL_ENABLED=@@PORTAL_ENABLED@@
CFLEX_PORTAL_URL=@@PORTAL_URL@@
CFLEX_TLS_CERT=@@MTLS_CERT@@
CFLEX_TLS_KEY=@@MTLS_KEY@@
CFLEX_TLS_CA=@@PORTAL_CA@@
CFLEX_PORTAL_BUFFER_DAYS=@@BUFFER_DAYS@@
CFLEX_PROFILE=@@PROFILE@@
# The Portal link (FW-4) and local notification (Q-2026-10-25-10, FW-8: SMTP to the relay directly,
# Teams/ServiceNow and the test ticket) go through the proxy.
HTTPS_PROXY=@@PROXY@@
NO_PROXY=@@NO_PROXY@@
