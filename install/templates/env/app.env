# cflex-app (Local Console API) environment — rendered by cflex-install @@INSTALLER_VERSION@@ (0600, owner cflex).
# Same on app01 and app02 except CONSOLE_NODE_ID and REDIS_URL. Secrets are files, never values here.
NODE_ENV=production
TZ=@@TIMEZONE@@
CONSOLE_NODE_ID=@@NODE_ID@@
CONSOLE_BIND=@@CONSOLE_BIND@@
CONSOLE_PORT=8080
# SQLite until WO-INT-008 (PostgreSQL 16 on db01).
CONSOLE_DB=@@DATA_DIR@@/console.db
REDIS_URL=redis://@@REDIS_ADDR@@:6379/0
REDIS_PASSWORD_FILE=@@SECRETS_DIR@@/redis.pass
CONSOLE_SECRET_KEY_FILE=@@SECRETS_DIR@@/console.key
CFLEX_TENANT=@@TENANT@@
CFLEX_TENANT_NAME=@@TENANT@@
CONSOLE_TRUST_PROXY=1
# Local notification is sent from here (Q-2026-10-25-10, FW-8): SMTP to the relay directly,
# Teams/ServiceNow and the test ticket through the proxy.
HTTPS_PROXY=@@PROXY@@
NO_PROXY=@@NO_PROXY@@
