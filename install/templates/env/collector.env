# cflex-collector environment — rendered by cflex-install @@INSTALLER_VERSION@@ from site.yaml (0600, owner cflex).
# Paths are inside the container; the host side of each is in the Quadlet unit.
NODE_ENV=production
TZ=@@TIMEZONE@@
CFLEX_PROFILE=@@PROFILE@@
TENANT_ID=@@TENANT@@
PROBE_ID=@@NODE_ID@@
CFLEX_NODE_ID=@@NODE_ID@@
CFLEX_SITE_ID=@@SITE_ID@@

# Portal (contract 00, FW-4). The device key never leaves this node (contract §6).
CFLEX_PORTAL_ENABLED=@@PORTAL_ENABLED@@
CFLEX_PORTAL_URL=@@PORTAL_URL@@
CFLEX_TLS_CERT=@@MTLS_CERT@@
CFLEX_TLS_KEY=@@MTLS_KEY@@
CFLEX_TLS_CA=@@PORTAL_CA@@
HTTPS_PROXY=@@PROXY@@
NO_PROXY=@@NO_PROXY@@

# Device list: the Local Console on the active app node (FW-7). The pull itself is WO-INT-004c;
# until then this only keeps the legacy cloud URL out of an on-prem install.
CFLEX_URL=https://@@ACTIVE_APP_IP@@

POLL_INTERVAL_MS=@@POLL_MS@@
HEARTBEAT_INTERVAL_MS=60000
BUFFER_DB_PATH=@@QUEUE_DIR@@/buffer.db
BUFFER_RETENTION_DAYS=@@BUFFER_DAYS@@
CFLEX_ITSM_STORE=@@QUEUE_DIR@@/itsm-map.json
CFLEX_ID_STORE=@@QUEUE_DIR@@/device-ids.json
CFLEX_HEALTH_FILE=@@HEALTH_FILE@@
SNMP_VERSION=@@SNMP_VERSION@@
# Trap listener port inside the process (WO-INT-006): 1162 in the container, 162 on bare.
CFLEX_TRAP_PORT=@@TRAP_LISTEN_PORT@@
