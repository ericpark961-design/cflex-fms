{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cflex.fms.support/schemas/v1.0/error.schema.json",
  "title": "Error body for every non-2xx response (contract IFC-CFLEX-2026-1023 v1.0 §1)",
  "x-contract-version": "1.0",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}
