# HAEA 미러 랩 — 공통 변수. 비밀값 없음 (SSH 키는 ~/.ssh, 경로만 적는다).
# 모든 스크립트가 source 한다.

# 구독·운영자 IP 는 repo 에 적지 않는다 — 실행 시 읽는다 (덮어쓰기: SUB=… MY_IP=… ./create.sh)
SUB=${SUB:-$(command az account show --query id -o tsv)}
LOC=westus2                                   # eastus 는 vCPU 한도(10) 소진
RG=RG-CFLEX-HAEA-LAB
VNET=vnet-haea-lab
TAGS="project=cflex-fms purpose=haea-mirror-lab owner=eric expires=2027-01-31"

# HAEA 와 같은 주소 (docs/spec/01 §1) — site.yaml 을 고치지 않고 쓰기 위해서다.
VNET_PREFIX=10.138.0.0/16
SNET_FMS=10.138.14.0/24        # cap01/app01/app02/db01
SNET_SVC=10.138.15.0/24        # HAEA 쪽 서비스 흉내 (프록시·SMTP·ServiceNow·포털 목) + 점프
SNET_NMC=10.138.16.0/24        # NMC 시뮬레이터 — 라우터 역할 (UDR next hop)

# NMC VLAN (부록 B) — VNet 밖 대역. UDR 로 nmcsim 에 보낸다.
# 이 경로를 지우면 "collector → NMC 라우팅 불가" (spec 01 §6-1) 를 재현할 수 있다.
NMC_ROUTES="10.112.0.0/16 10.119.0.0/16 10.189.193.0/24"

RHEL_IMAGE=RedHat:RHEL:8_10:8.10.2026102317   # 고정 — HAEA 8.10 과 맞춘다
UBUNTU_IMAGE=Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest

ADMIN=azureuser
SSH_KEY=$HOME/.ssh/cflex_haea_lab_ed25519
MY_IP=${MY_IP:-$(curl -s -m 5 https://ifconfig.me)}   # 점프 SSH 허용 대상 = 지금 실행하는 머신의 공인 IP

# 매일 자동 종료 (UTC). 0300 UTC = 19:00 PST / 20:00 PDT.
SHUTDOWN_UTC=0300

# name  size  ip  role  datadisk_gb  datadisk_mount  hostname
# role: rhel-<collector|app|db> | svc | nmcsim
NODES="
cap01   Standard_B2s   10.138.14.66 rhel-collector 0   -         haeipfmscap01v
app01   Standard_B2ms  10.138.14.67 rhel-app       64  /opt/app  haeipfmsapp01v
app02   Standard_B2ms  10.138.14.68 rhel-app       64  /opt/app  haeipfmsapp02v
db01    Standard_B2ms  10.138.14.69 rhel-db        128 /opt/data haeipfmsdb01v
svc     Standard_B1s   10.138.15.10 svc            0   -         haea-svc
nmcsim  Standard_B1s   10.138.16.20 nmcsim         0   -         haea-nmcsim
"
PROXY=http://10.138.15.10:3128
