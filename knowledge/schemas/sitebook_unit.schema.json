{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cflex/knowledge/sitebook_unit.schema.json",
  "title": "C-Flex Site Book — unit (K3)",
  "type": "object",
  "required": ["schema_version", "tenant", "site", "unit_id", "unit_name", "build_up", "environment", "cabling", "baseline", "pm_history", "source_refs", "updated_by", "updated_at"],
  "$defs": { "u": { "anyOf": [ { "type": ["string", "number", "boolean", "null"] }, { "type": "object" }, { "type": "array" } ], "description": "미확인은 문자열 'unknown' — 추정값 금지" } },
  "properties": {
    "schema_version": { "const": 1 },
    "tenant": { "type": "string" }, "site": { "type": "string" },
    "unit_id": { "type": "string", "pattern": "^[A-Z0-9-]+$" }, "unit_name": { "type": "string" },
    "in_sow": { "type": "boolean" }, "quantity_basis": { "type": "string" },
    "build_up": { "type": "object", "required": ["manufacturer", "model", "serial", "firmware_ups", "battery"], "properties": {
      "manufacturer": { "type": "string" }, "model": { "type": "string" }, "model_family": { "$ref": "#/$defs/u" }, "serial": { "type": "string", "pattern": "^[A-Z0-9]{10,16}$" },
      "mfg_date": { "$ref": "#/$defs/u" }, "firmware_ups": { "$ref": "#/$defs/u" }, "firmware_nmc": { "$ref": "#/$defs/u" }, "nmc_model": { "$ref": "#/$defs/u" }, "nmc_mac": { "$ref": "#/$defs/u" },
      "rated": { "$ref": "#/$defs/u" }, "input_voltage_nominal": { "$ref": "#/$defs/u" }, "output_voltage_nominal": { "$ref": "#/$defs/u" }, "phase": { "$ref": "#/$defs/u" },
      "battery": { "type": "object", "properties": { "type": { "$ref": "#/$defs/u" }, "strings": { "$ref": "#/$defs/u" }, "modules_expected": { "$ref": "#/$defs/u" }, "modules_registered": { "$ref": "#/$defs/u" }, "install_date": { "$ref": "#/$defs/u" }, "replace_due": { "$ref": "#/$defs/u" }, "status_at_pm": { "$ref": "#/$defs/u" } } },
      "options": { "type": "object" } } },
    "environment": { "type": "object", "properties": { "building": {}, "room": {}, "cabinet_or_rack": {}, "ru_position": {}, "room_temp_c_baseline": {}, "humidity_baseline": {}, "hvac_note": {}, "nmc_env_prev_high_ts": {} } },
    "cabling": { "type": "object", "properties": { "input_panel": {}, "input_breaker": {}, "output_breaker": {}, "output_pdu_targets": { "type": "array" }, "bypass_location": {}, "nmc_port": { "type": "object" }, "snmp_version": {}, "console_cable": {} },
      "not": { "required": ["snmp_community", "snmp_v3_auth_password", "snmp_v3_priv_password"] } },
    "baseline": { "type": "object", "required": ["source"], "properties": { "source": { "enum": ["pm_report", "telemetry_7d_median", "none"] }, "measured_at": {}, "load_pct": {}, "load_kw": {}, "runtime": {}, "dc_v": {}, "input_v_measured": {}, "output_v_measured": {}, "output_a": {}, "batt_temp_c": {}, "efficiency_pct": {}, "self_test_last": {}, "self_test_prev": {} } },
    "pm_history": { "type": "array", "items": { "type": "object", "required": ["date", "result"], "properties": { "date": { "type": "string" }, "quarter": {}, "result": { "enum": ["PASS", "FAIL", "PARTIAL"] }, "checks_passed": {}, "checks_na": {}, "alarm_history_cleared": {}, "findings": { "type": "array", "items": { "type": "string" } }, "fse": {}, "report_file": {} } } },
    "alarm_history_baseline": { "type": "object" },
    "runbook_candidates": { "type": "array", "items": { "type": "string", "pattern": "^RB-" } },
    "source_refs": { "type": "array", "minItems": 1 },
    "updated_by": { "type": "string" }, "updated_at": { "type": "string" }
  }
}
