# cflex-app environment — identical on app01 and app02 except CONSOLE_NODE_ID.
# Secrets are files (0600, owner cflex), never values here.

CONSOLE_NODE_ID=app01
CONSOLE_BIND=0.0.0.0
CONSOLE_PORT=8080

# SQLite until WO-INT-008 (PostgreSQL 16 on db01). Both nodes must use the same store.
CONSOLE_DB=/opt/app/cflex/data/console.db

# Redis 6 on app01 (sessions, login-failure counters). app02 points at the same one.
REDIS_URL=redis://10.138.14.67:6379/0
REDIS_PASSWORD_FILE=/opt/app/cflex/secrets/redis.pass

# 32 bytes (64 hex) — seals SNMP and notification-channel secrets. Same file on both nodes.
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /opt/app/cflex/secrets/console.key; chmod 600 …
CONSOLE_SECRET_KEY_FILE=/opt/app/cflex/secrets/console.key

CFLEX_TENANT=HAEA
CFLEX_TENANT_NAME=HAEA

# The console build of apps/twin (npm run build:console).
CONSOLE_TWIN_DIR=/opt/app/cflex/web/twin

# For the ServiceNow test ticket (app → proxy → ServiceNow 443).
# HTTPS_PROXY=http://<haea-proxy>:<port>

# Defaults, shown for reference:
# CONSOLE_SESSION_IDLE_S=1800
# CONSOLE_SESSION_MAX_S=43200
# CONSOLE_LOCKOUT_FAILS=5
# CONSOLE_LOCKOUT_S=900
# CONSOLE_STALE_S=300
# CONSOLE_COOKIE_SECURE=1
# CONSOLE_TRUST_PROXY=1
