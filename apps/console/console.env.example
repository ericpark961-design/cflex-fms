# cflex-app environment — identical on app01 and app02 except CONSOLE_NODE_ID.
# Secrets are files (0600, owner cflex), never values here.

CONSOLE_NODE_ID=app01
CONSOLE_BIND=0.0.0.0
CONSOLE_PORT=8080

# PostgreSQL 16 on db01 (WO-INT-008) — the same database for both nodes. Either the parts or a URL
# without the password (postgres://cflex@10.138.14.69:5432/cflex in CFLEX_DB_URL); the password only from the file.
CFLEX_DB_HOST=10.138.14.69
CFLEX_DB_PORT=5432
CFLEX_DB_NAME=cflex
CFLEX_DB_USER=cflex
CFLEX_DB_PASSWORD_FILE=/opt/app/cflex/secrets/pg.pass
# Retention (spec 01 §2.3) and month partitions made ahead; the partition round runs on start and every 6 h.
# CFLEX_RETENTION_RAW_YEARS=3
# CFLEX_RETENTION_AGGREGATE_YEARS=10
# CFLEX_RETENTION_EVENTS_YEARS=10
# CFLEX_PARTITION_AHEAD_MONTHS=3
# CFLEX_PARTITION_INTERVAL_H=6
# CFLEX_DB_POOL_MAX=10

# The pre-WO-INT-008 SQLite store, read once by bin/cflex-migrate-sqlite.js.
CONSOLE_DB=/opt/app/cflex/data/console.db

# Redis 6 on app01 (sessions, login-failure counters). app02 points at the same one.
REDIS_URL=redis://10.138.14.67:6379/0
REDIS_PASSWORD_FILE=/opt/app/cflex/secrets/redis.pass

# 32 bytes (64 hex) — seals SNMP and notification-channel secrets. Same file on both nodes.
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /opt/app/cflex/secrets/console.key; chmod 600 …
CONSOLE_SECRET_KEY_FILE=/opt/app/cflex/secrets/console.key

CFLEX_TENANT=HAEA
CFLEX_TENANT_NAME=HAEA

# The console build of apps/twin (npm run build:console).
CONSOLE_TWIN_DIR=/opt/app/cflex/web/twin

# Local notification is sent from the console (Q-2026-10-25-10 (A), v3 FW-8):
# SMTP to the relay directly, Teams/ServiceNow (and the test ticket) through the proxy.
# HTTPS_PROXY=http://<haea-proxy>:<port>
# NO_PROXY=<relay host>,.haea.local
# CONSOLE_PROXY_CA=/opt/app/cflex/config/proxy-ca.pem     # only for a TLS-inspecting proxy

# The Portal link (contract 00 v1.2, D-13): this node sends for every collector (FW-4, through the proxy above).
# Paths only — the device key (CN <tenant>.<node>) stays on this node, 0600.
# CFLEX_PORTAL_ENABLED=1
# CFLEX_PORTAL_URL=https://cflex.fms.support
# CFLEX_TLS_CERT=/opt/app/cflex/certs/device.pem
# CFLEX_TLS_KEY=/opt/app/cflex/certs/device.key
# CFLEX_TLS_CA=/opt/app/cflex/certs/portal-ca.pem
# CFLEX_PORTAL_BUFFER_DAYS=7

# internal (default): no portal-scope API. portal: the full twin build's compatibility answers.
# CONSOLE_PROFILE=internal

# Defaults, shown for reference:
# CONSOLE_SESSION_IDLE_S=1800
# CONSOLE_SESSION_MAX_S=43200
# CONSOLE_LOCKOUT_FAILS=5
# CONSOLE_LOCKOUT_S=900
# CONSOLE_STALE_S=300
# CONSOLE_COOKIE_SECURE=1
# CONSOLE_TRUST_PROXY=1
# CONSOLE_NOTIFY_REPLAY_MAX_S=900
